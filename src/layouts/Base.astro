---
import "../styles/global.css";
import { site } from "../lib/data";
const { title, description = "", bodyClass = "" } = Astro.props;
const name = site.business.name.startsWith("[") ? site.business.short : site.business.name;
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ? `${title} · ${name}` : name}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@300;400;500;600&family=Noto+Serif+Thai:wght@300;400;500;600&display=swap" />
  </head>
  <body class={bodyClass}>
    <slot />
    <script>
      // Header turns solid once the full-screen photo has scrolled past.
      const hdr = document.querySelector<HTMLElement>("[data-hdr]");
      if (hdr) {
        const update = () => hdr.classList.toggle("solid", window.scrollY > window.innerHeight * 0.6 || hdr.dataset.always === "solid");
        update();
        window.addEventListener("scroll", update, { passive: true });
      }
      // Mobile menu
      const drawer = document.getElementById("drawer");
      const scrim = document.getElementById("scrim");
      const setDrawer = (open: boolean) => {
        if (!drawer || !scrim) return;
        drawer.hidden = !open; scrim.hidden = !open;
        document.querySelector("[data-menu]")?.setAttribute("aria-expanded", String(open));
      };
      document.querySelector("[data-menu]")?.addEventListener("click", () => setDrawer(true));
      scrim?.addEventListener("click", () => setDrawer(false));
      drawer?.addEventListener("click", (e) => { if ((e.target as Element).closest("a,[data-close]")) setDrawer(false); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") setDrawer(false); });
    </script>
  </body>
</html>

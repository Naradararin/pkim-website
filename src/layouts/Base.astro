---
import "../styles/global.css";
import { brandName, url, type Lang } from "../lib/data";
const { title, description = "", lang = "th", alt = "/" } = Astro.props as { title?: string; description?: string; lang?: Lang; alt?: string };
// `alt` is this page's path without the language prefix, e.g. "/portfolio/".
const name = brandName(lang);
const other: Lang = lang === "th" ? "en" : "th";
const otherHref = url(alt, other);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ? `${title} · ${name}` : name}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href={url("/favicon.png")} />
    <link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
    <link rel="alternate" hreflang="th" href={url(alt, "th")} />
    <link rel="alternate" hreflang="en" href={url(alt, "en")} />
    <meta name="lang-alt" content={otherHref} />
    <script is:inline define:vars={{ lang, otherHref }}>
      // Remember the chosen language: Thai pages send visitors who chose English to the English page.
      try {
        const saved = localStorage.getItem("lang");
        if (lang === "th" && saved === "en") location.replace(otherHref + location.search + location.hash);
        else if (lang === "en") localStorage.setItem("lang", "en");
      } catch (_) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wdth,wght@62.5,100;62.5,200;100,100&family=IBM+Plex+Sans+Thai:wght@400;500;600&family=Trirong:wght@300;400;500&family=Sarabun:wght@300;400;500&family=Pinyon+Script&family=Playfair+Display:wght@400;500&family=Manrope:wght@300;400;500&display=swap" />
  </head>
  <body>
    <slot />
    <script>
      // Language switch: remember the choice and keep filters/anchors.
      document.addEventListener("click", (e) => {
        const a = (e.target as Element).closest<HTMLAnchorElement>("[data-lang-to]");
        if (!a) return;
        try { localStorage.setItem("lang", a.dataset.langTo!); } catch (_) {}
        a.href = a.href.split(/[?#]/)[0] + location.search + location.hash;
      });
      // Fade sections in as they scroll into view.
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
        const sel = ".sec-head, .pband .top > .btn, .pitem, .why-photo, .point, .bcard, .story .im, .story .card, .w-intro .wrap > *, .filters, .tile, .reviews blockquote, .contact-grid > *, .plain h2, .cs-side, .cs-text, .cs-mag .f, .cs-nav, .related h2, .w-cta .inner";
        const els = [...document.querySelectorAll<HTMLElement>(sel)];
        const io = new IntersectionObserver((entries) => {
          for (const en of entries) if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); }
        }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
        for (const el of els) {
          const sibs = el.parentElement ? [...el.parentElement.children].filter((c) => c.matches(sel)) : [];
          el.style.setProperty("--d", `${Math.min(sibs.indexOf(el), 5) * 0.09}s`);
          el.classList.add("reveal");
          io.observe(el);
        }
      }
      // Header turns solid once the full-screen photo has scrolled past.
      const hdr = document.querySelector<HTMLElement>("[data-hdr]");
      if (hdr) {
        const update = () => hdr.classList.toggle("solid", window.scrollY > window.innerHeight * 0.6);
        update();
        window.addEventListener("scroll", update, { passive: true });
      }
      // Mobile menu
      const drawer = document.getElementById("drawer");
      const scrim = document.getElementById("scrim");
      const setDrawer = (open: boolean) => {
        if (!drawer || !scrim) return;
        drawer.hidden = !open; scrim.hidden = !open;
        document.querySelector("[data-menu]")?.setAttribute("aria-expanded", String(open));
      };
      document.querySelector("[data-menu]")?.addEventListener("click", () => setDrawer(true));
      scrim?.addEventListener("click", () => setDrawer(false));
      drawer?.addEventListener("click", (e) => { if ((e.target as Element).closest("a,[data-close]")) setDrawer(false); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") setDrawer(false); });
    </script>
    <script>
      // Glide to in-page sections instead of jumping
      const ease = (t: number) => (t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
      document.addEventListener("click", (e) => {
        const a = (e.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
        if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey || a.pathname !== location.pathname) return;
        const id = decodeURIComponent(a.hash.slice(1)); if (!id) return;
        const el = document.getElementById(id); if (!el) return;
        e.preventDefault();
        const from = scrollY, to = id === "top" ? 0 : el.getBoundingClientRect().top + scrollY - 80, d = to - from;
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) { scrollTo(0, to); return; }
        const dur = Math.min(1700, 700 + Math.abs(d) * .25), t0 = performance.now();
        const step = (now: number) => { const t = Math.min(1, (now - t0) / dur); scrollTo(0, from + d * ease(t)); if (t < 1) requestAnimationFrame(step); else history.replaceState(null, "", "#" + id); };
        requestAnimationFrame(step);
      });
    </script>
  </body>
</html>

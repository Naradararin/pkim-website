---
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import WorksHeader from "../components/WorksHeader.astro";
import Img from "../components/Img.astro";
import T from "../components/T.astro";
import Tile from "../components/Tile.astro";
import Icon from "../components/Icon.astro";
import { jobs, url, t, view, lineHref, type Job, type Lang } from "../lib/data";

const { job: j, lang } = Astro.props as { job: Job; lang: Lang };
const v = view(j, lang);
const alt = `/portfolio/${j.id}/`;
const idx = jobs.indexOf(j);
const newer = jobs[idx - 1];
const older = jobs[idx + 1];
const related = jobs.filter((x) => x !== j && x.jobTypes.some((y) => j.jobTypes.includes(y))).slice(0, 3);

// Lay the photos out like a magazine: landscape photos full width,
// two portrait photos side by side, a lone portrait centred.
const rest = j.photos.filter((p) => p !== j.coverImg);
const isWide = (p: ImageMetadata) => p.width >= p.height * 1.05;
const rows: { kind: "wide" | "pair" | "solo"; items: ImageMetadata[] }[] = [];
for (let i = 0; i < rest.length; i++) {
  const p = rest[i];
  if (isWide(p)) rows.push({ kind: "wide", items: [p] });
  else if (rest[i + 1] && !isWide(rest[i + 1])) { rows.push({ kind: "pair", items: [p, rest[i + 1]] }); i++; }
  else rows.push({ kind: "solo", items: [p] });
}
const text = v.story || v.summary;
---
<Base lang={lang} alt={alt} title={v.title} description={`${v.title} · ${v.jobTypes.join(", ")} · ${v.province}`}>
  <WorksHeader lang={lang} alt={alt} />
  <main>
    <section class="scene cs-hero">
      <Img class="bg" src={j.coverImg} alt={v.title} loading="eager" />
      <div class="wrap inner">
        <span class="eyebrow">{j.level === "High-End" ? "High-End · " : ""}{v.jobTypes.join(" · ")}</span>
        <h1>{v.title}</h1>
        <div class="m"><span>{v.dateText}</span>{v.subtitle && <span>{v.subtitle}</span>}<span>{j.photos.length} {t(lang, "works.photos")}</span></div>
      </div>
    </section>

    <div class="wrap cs-body">
      <aside class="cs-side">
        <dl class="facts">
          <dt>{t(lang, "job.date")}</dt><dd>{v.dateText}</dd>
          {j.place && <><dt>{t(lang, "job.place")}</dt><dd>{j.place}</dd></>}
          <dt>{t(lang, "job.housing")}</dt><dd>{v.housing}</dd>
          <dt>{t(lang, "job.province")}</dt><dd>{v.province}</dd>
          <dt>{t(lang, "job.jobTypes")}</dt><dd>{v.jobTypes.join(", ")}</dd>
          {v.curtainTypes.length > 0 && <><dt>{t(lang, "job.curtainTypes")}</dt><dd>{v.curtainTypes.join(", ")}</dd></>}
          {j.blackout && <><dt>{t(lang, "job.blackout")}</dt><dd>{j.blackout}</dd></>}
        </dl>
        <a class="btn dark" href={lineHref(lang)}>{t(lang, "cta.consultLike")}</a>
        {j.facebook && <a class="link" href={j.facebook} target="_blank" rel="noopener" style="justify-self:start;display:inline-flex;gap:6px;align-items:center">{t(lang, "cta.fbPost")} <Icon name="external" /></a>}
      </aside>
      <div>
        {text ? (
          <div class="cs-text"><p>{text}</p></div>
        ) : j.featured ? (
          <div class="cs-text"><h2>{t(lang, "job.storyTitle")}</h2><T as="p" s={t(lang, "job.storyTodo")} lang={lang} /></div>
        ) : null}
        <div class="cs-photos">
          {rows.map((r) =>
            r.kind === "pair" ? (
              <div class="row2">{r.items.map((p) => <Img src={p} alt="" sizes="(max-width: 520px) 100vw, 420px" />)}</div>
            ) : (
              <div class={r.kind === "solo" ? "solo" : ""}><Img src={r.items[0]} alt="" sizes="(max-width: 860px) 100vw, 860px" /></div>
            )
          )}
        </div>
      </div>
    </div>

    <nav class="wrap cs-nav" aria-label={t(lang, "job.otherWorks")}>
      {newer ? <a href={url(`/portfolio/${newer.id}/`, lang)}><small>{t(lang, "job.newer")}</small><b>{view(newer, lang).title}</b></a> : <a href={url("/portfolio/#collection", lang)}><small>←</small><b>{t(lang, "nav.allWorks")}</b></a>}
      {older ? <a href={url(`/portfolio/${older.id}/`, lang)}><small>{t(lang, "job.older")}</small><b>{view(older, lang).title}</b></a> : <a href={url("/portfolio/#collection", lang)}><small>→</small><b>{t(lang, "nav.allWorks")}</b></a>}
    </nav>

    {related.length > 0 && (
      <section class="related">
        <div class="wrap">
          <h2>{t(lang, "job.related")}</h2>
          <div class="mosaic">{related.map((r) => <Tile job={r} lang={lang} />)}</div>
          <p style="margin-top:28px;display:flex;gap:12px;flex-wrap:wrap">
            <a class="btn dark" href={url("/portfolio/#collection", lang)}>{t(lang, "nav.allWorks")}</a>
            <a class="btn" href={url("/", lang)}>← {t(lang, "nav.backHome")}</a>
          </p>
        </div>
      </section>
    )}
  </main>
</Base>

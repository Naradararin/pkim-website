---
import Img from "./Img.astro";
import { url, curtainLabel, type Job } from "../lib/data";
const { job: j } = Astro.props as { job: Job };
---
<a class="tile" href={url(`/portfolio/${j.id}/`)} data-job={j.jobTypes.join("|")} data-curtain={j.curtainTypes.join("|")}>
  <Img src={j.coverImg} alt="" sizes="(max-width: 520px) 100vw, (max-width: 900px) 50vw, 400px" widths={[480, 800]} />
  {j.level === "High-End" && <span class="lv">HIGH-END</span>}
  <div class="cap">
    <h3>{j.title}</h3>
    <div class="m"><span>{j.dateText}</span><span>{j.subtitle || j.province}</span><span>{[...j.jobTypes, ...j.curtainTypes.map(curtainLabel)].join(" · ")}</span></div>
  </div>
</a>

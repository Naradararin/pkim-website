---
import Icon from "./Icon.astro";
import { site, url } from "../lib/data";
---
<header class="w-hdr" data-hdr>
  <div class="wrap w-bar">
    <a class="back" href={url("/")}><Icon name="back" /><span class="lbl">กลับหน้าหลัก</span></a>
    <a class="brand" href={url("/portfolio/")}><b>{site.business.short}</b><small>PORTFOLIO</small></a>
    <div class="right">
      <a class="hide-s" href={url("/portfolio/#collection")}>ผลงานทั้งหมด</a>
      <a class="btn" href={site.contact.lineUrl || url("/#contact")}>ปรึกษา</a>
    </div>
  </div>
</header>
